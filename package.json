{
  "name": "margin-legal-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-grounded AI for Legal Assistance & Access: understand, compare, and navigate legal documents.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"tsx watch --env-file-if-exists=.env.local scripts/dev-server.ts\"",
    "build": "tsc --noEmit && vite build && npm run build:api && npm run test:runtime",
    "build:api": "tsc -p tsconfig.server.json",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "tsx --env-file-if-exists=.env.local scripts/dev-server.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-smoke.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run format:check",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@google/genai": "2.22.0",
    "@hono/node-server": "2.1.1",
    "@phosphor-icons/react": "2.1.10",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.10.0",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
